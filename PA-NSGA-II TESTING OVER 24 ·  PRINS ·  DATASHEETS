    print(" BENCHMARK COMPLETED SUCCESSFULLY ".center(80, "="))
    print("="*80)
    print(f"\n📁 Output directory: {OUTPUT_DIR}/")
    print(f"   - benchmark_results_complete.csv")
    print(f"   - plots/ (7 visualization files)")
    print(f"   - statistics/ (statistics_summary.csv)")
    print("\n" + "="*80)


