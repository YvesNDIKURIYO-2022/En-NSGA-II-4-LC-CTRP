class PrinsExcelLoader:
    def __init__(self, excel_path: str):
        self.excel_path = Path(excel_path)
    
    def get_all_sheets(self) -> List[str]:
        try:
            xl = pd.ExcelFile(self.excel_path)
            return xl.sheet_names
        except Exception as e:
            print(f"Error reading Excel file: {e}")
            return []
    
    def load_instance(self, sheet_name: str) -> Dict:
        df = pd.read_excel(self.excel_path, sheet_name=sheet_name, header=None)
        
        instance_data = {
            'name': sheet_name,
            'is_green': sheet_name.startswith('G'),
            'depots': [],
            'customers': [],
            'vehicle_capacity': 150,
            'route_fixed_cost': 1000,
        }
        
        for idx, row in df.iterrows():
            if len(row) < 4:
                continue
            first_cell = str(row.iloc[0]) if pd.notna(row.iloc[0]) else ""
            
            if first_cell.startswith('d'):
                try:
                    depot = {
                        'id': first_cell,
                        'x': float(row.iloc[1]) if pd.notna(row.iloc[1]) else 0,
                        'y': float(row.iloc[2]) if pd.notna(row.iloc[2]) else 0,
                        'capacity': float(row.iloc[3]) if pd.notna(row.iloc[3]) else 140,
                        'fixed_cost': float(row.iloc[4]) if pd.notna(row.iloc[4]) else 10000,
                    }
                    instance_data['depots'].append(depot)
                except:
                    pass
            
            elif 'vehicle capacity' in str(row.iloc[5]) if len(row) > 5 and pd.notna(row.iloc[5]) else False:
                try:
                    instance_data['vehicle_capacity'] = float(row.iloc[6]) if len(row) > 6 and pd.notna(row.iloc[6]) else 150
                except:
                    pass
        
        for idx, row in df.iterrows():
            try:
                first_cell = str(row.iloc[0]) if pd.notna(row.iloc[0]) else ""
                if first_cell.replace('.', '').replace('-', '').isdigit() and not first_cell.startswith('d'):
                    cust_id = int(float(first_cell))
                    if 1 <= cust_id <= 500:
                        customer = {
                            'id': cust_id,
                            'x': float(row.iloc[1]) if pd.notna(row.iloc[1]) else 0,
                            'y': float(row.iloc[2]) if pd.notna(row.iloc[2]) else 0,
                            'demand': float(row.iloc[3]) if pd.notna(row.iloc[3]) else 10,
                        }
                        instance_data['customers'].append(customer)
            except:
                continue
        
        instance_data['n_depots'] = len(instance_data['depots'])
        instance_data['n_customers'] = len(instance_data['customers'])
        instance_data['emission_factor'] = 0.120
        instance_data['fuel_cost'] = 0.23
        
        return instance_data


