class PANSGAII(BaseAlgorithm):
    def __init__(self, problem, pop_size=60, n_gen=50, run_id=0, seed=None):
        super().__init__(problem, pop_size, n_gen, "PA-NSGA-II", run_id, seed)
        self.crossover_rate = 0.85
        self.mutation_rate = 0.12
        self.adaptation_history = {'crossover': [], 'mutation': [], 'diversity': []}
        self.diversity_window = []
        self.stagnation_counter = 0
        self.best_emissions_history = []
    
    def adapt_parameters(self, population_diversity: float, generation: int):
        """CORRECTED adaptive parameter control"""
        self.diversity_window.append(population_diversity)
        if len(self.diversity_window) > 10:
            self.diversity_window.pop(0)
        
        if len(self.diversity_window) >= 5:
            diversity_trend = np.mean(self.diversity_window[-5:]) - np.mean(self.diversity_window[:5])
        else:
            diversity_trend = 0
        
        # LOW diversity -> increase exploration (higher mutation, lower crossover)
        if population_diversity < 0.15:
            self.mutation_rate = min(0.35, self.mutation_rate + 0.02)
            self.crossover_rate = max(0.65, self.crossover_rate - 0.02)
            self.stagnation_counter += 1
        
        # HIGH diversity -> increase exploitation (lower mutation, higher crossover)
        elif population_diversity > 0.45:
            self.mutation_rate = max(0.05, self.mutation_rate - 0.01)
            self.crossover_rate = min(0.95, self.crossover_rate + 0.01)
            self.stagnation_counter = max(0, self.stagnation_counter - 1)
        
        # Balanced -> moderate parameters
        else:
            self.mutation_rate = 0.12
            self.crossover_rate = 0.85
        
        # Severe stagnation - force exploration
        if self.stagnation_counter > 5:
            self.mutation_rate = 0.35
            self.crossover_rate = 0.6
            self.stagnation_counter = 0
        
        # Adaptive mutation strength based on generation
        if generation < self.n_gen * 0.3:
            self.mutation_strength = 0.15
        elif generation < self.n_gen * 0.7:
            self.mutation_strength = 0.08
        else:
            self.mutation_strength = 0.03
        
        # Record adaptation
        self.adaptation_history['crossover'].append(float(self.crossover_rate))
        self.adaptation_history['mutation'].append(float(self.mutation_rate))
        self.adaptation_history['diversity'].append(float(population_diversity))
    
    def greedy_distance_init(self) -> np.ndarray:
        """Distance-based greedy initialization"""
        ind = np.zeros(self.n_vars)
        for cust_idx in range(self.n_vars):
            cust_coord = self.problem.customer_coords[cust_idx]
            depot_distances = []
            for d_idx, depot_coord in enumerate(self.problem.depot_coords):
                dist = np.sqrt((cust_coord[0] - depot_coord[0])**2 + 
                              (cust_coord[1] - depot_coord[1])**2)
                depot_distances.append((d_idx, dist))
            nearest_depot = min(depot_distances, key=lambda x: x[1])[0]
            ind[cust_idx] = nearest_depot / max(1, self.problem.n_depots)
        return ind
    
    def greedy_cost_init(self) -> np.ndarray:
        """Cost-based greedy initialization"""
        ind = np.zeros(self.n_vars)
        depot_costs = self.problem.depot_fixed_costs
        sorted_depots = np.argsort(depot_costs)
        for i in range(self.n_vars):
            ind[i] = sorted_depots[i % max(1, self.problem.n_depots)] / max(1, self.problem.n_depots)
        return ind
    
    def init_pop(self) -> List[np.ndarray]:
        """Enhanced initialization with greedy heuristics"""
        pop = []
        depot_costs = self.problem.depot_fixed_costs
        n_depots = self.problem.n_depots
        
        if n_depots == 0:
            return [np.random.rand(self.n_vars) for _ in range(self.pop_size)]
        
        # 1. Greedy cost-based (20%)
        n_cost = max(1, self.pop_size // 5)
        for _ in range(n_cost):
            pop.append(self.greedy_cost_init())
        
        # 2. Greedy distance-based (20%)
        n_dist = max(1, self.pop_size // 5)
        for _ in range(n_dist):
            pop.append(self.greedy_distance_init())
        
        # 3. Diverse random with bias toward good depots (60%)
        best_depots = np.argsort(depot_costs)[:max(1, n_depots // 3)]
        remaining = self.pop_size - len(pop)
        for _ in range(remaining):
            ind = np.random.rand(self.n_vars)
            mask = np.random.rand(self.n_vars) < 0.4
            ind[mask] = np.random.choice(best_depots, np.sum(mask)) / n_depots
            pop.append(np.clip(ind, 0, 0.99))
        
        return pop
    
    def run(self):
        pop = self.init_pop()
        objs = self.evaluate(pop)
        
        for gen in range(self.n_gen):
            # Non-dominated sorting
            fronts = self.non_dominated_sort(objs)
            ranks = [-1] * len(pop)
            crowding = [0.0] * len(pop)
            
            for i, front in enumerate(fronts):
                dists = self.crowding_distance(objs, front)
                for j, idx in enumerate(front):
                    ranks[idx] = i
                    crowding[idx] = dists[j]
            
            # Adaptive parameter control
            current_diversity = self.calc_diversity(self.get_pareto(pop, objs))
            self.adapt_parameters(current_diversity, gen)
            
            # Generate offspring
            offspring = []
            for _ in range(self.pop_size // 2):
                p1 = self.tournament(pop, objs, ranks, crowding)
                p2 = self.tournament(pop, objs, ranks, crowding)
                c1, c2 = self.crossover(p1, p2)
                c1 = self.mutate(c1)
                c2 = self.mutate(c2)
                
                # Apply local search to a subset of offspring
                ls_prob = 0.15 if gen < self.n_gen * 0.5 else 0.25
                if random.random() < ls_prob:
                    c1 = self.local_search(c1)
                if random.random() < ls_prob:
                    c2 = self.local_search(c2)
                
                offspring.append(c1)
                offspring.append(c2)
            
            # Evaluate offspring
            off_objs = self.evaluate(offspring)
            
            # Combine and select next generation
            combined_pop = pop + offspring
            combined_objs = objs + off_objs
            combined_fronts = self.non_dominated_sort(combined_objs)
            
            new_pop, new_objs = [], []
            for front in combined_fronts:
                if len(new_pop) + len(front) <= self.pop_size:
                    for idx in front:
                        new_pop.append(combined_pop[idx])
                        new_objs.append(combined_objs[idx])
                else:
                    dists = self.crowding_distance(combined_objs, front)
                    front_with_dist = [(idx, dists[j]) for j, idx in enumerate(front)]
                    front_with_dist.sort(key=lambda x: -x[1])
                    needed = self.pop_size - len(new_pop)
                    for idx, _ in front_with_dist[:needed]:
                        new_pop.append(combined_pop[idx])
                        new_objs.append(combined_objs[idx])
                    break
            
            pop, objs = new_pop, new_objs
            
            # Update archive with elite solutions
            self.update_archive(pop, objs)
            
            # Track metrics
            pareto = self.get_pareto(pop, objs)
            hv = self.calc_hypervolume(pareto)
            diversity = self.calc_diversity(pareto)
            
            best_emissions = min(o[1] for o in pareto) if pareto else 0
            best_cost = min(o[0] for o in pareto) if pareto else 0
            
            self.history['hv'].append(float(hv))
            self.history['best_emissions'].append(float(best_emissions))
            self.history['best_cost'].append(float(best_cost))
            self.history['diversity'].append(float(diversity))
            self.best_emissions_history.append(best_emissions)
        
        self.pareto_front = self.get_pareto(pop, objs)
        return {
            'hypervolume': float(self.history['hv'][-1]) if self.history['hv'] else 0.0,
            'best_emissions': float(min(o[1] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'best_cost': float(min(o[0] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'best_time': float(min(o[2] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'pareto_size': int(len(self.pareto_front)),
            'diversity': float(self.history['diversity'][-1]) if self.history['diversity'] else 0.0,
            'history': self.history,
            'adaptation': self.adaptation_history,
            'pareto_front': self.pareto_front
        }


