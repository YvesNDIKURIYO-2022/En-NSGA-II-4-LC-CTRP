class ResultVisualizer:
    def __init__(self, output_dir: Path):
        self.output_dir = output_dir
        self.plots_dir = output_dir / "plots"
        self.plots_dir.mkdir(exist_ok=True)
    
    def create_box_plots(self, results_df: pd.DataFrame):
        print("\n--- Creating Box Plots ---")
        algorithms = ['En-NSGA-II', 'NSGA-II', 'SPEA2', 'MOEA/D']
        
        fig, axes = plt.subplots(1, 3, figsize=(15, 5))
        
        metrics = [
            ('Hypervolume', 'Hypervolume', axes[0]),
            ('Best_Emissions_kg', 'CO₂ Emissions (kg)', axes[1]),
            ('Time_Seconds', 'Runtime (seconds)', axes[2])
        ]
        
        for metric, ylabel, ax in metrics:
            data = [results_df[results_df['Algorithm'] == algo][metric].dropna().values for algo in algorithms]
            data = [d for d in data if len(d) > 0]
            labels = [algo for algo, d in zip(algorithms, data) if len(d) > 0]
            
            if data:
                bp = ax.boxplot(data, labels=labels, patch_artist=True, showfliers=False)
                for patch, label in zip(bp['boxes'], labels):
                    patch.set_facecolor(COLORS[label])
                    patch.set_alpha(0.7)
                ax.set_ylabel(ylabel, fontsize=11, fontweight='bold')
                ax.set_title(f'{metric} Comparison', fontsize=12, fontweight='bold')
                ax.grid(True, alpha=0.3)
                ax.tick_params(axis='x', rotation=45)
        
        plt.suptitle('Algorithm Performance Comparison', fontsize=14, fontweight='bold')
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'box_plots.pdf', bbox_inches='tight', dpi=300)
        plt.close()
        print("  ✓ Saved: box_plots.pdf")
    
    def create_violin_plots(self, results_df: pd.DataFrame):
        print("--- Creating Violin Plots ---")
        fig, axes = plt.subplots(1, 2, figsize=(14, 6))
        
        metrics = [
            ('Hypervolume', 'Hypervolume', axes[0]),
            ('Best_Emissions_kg', 'CO₂ Emissions (kg)', axes[1])
        ]
        
        for metric, ylabel, ax in metrics:
            data = []
            labels = []
            for algo in ['En-NSGA-II', 'NSGA-II', 'SPEA2', 'MOEA/D']:
                d = results_df[results_df['Algorithm'] == algo][metric].dropna().values
                if len(d) > 0:
                    data.append(d)
                    labels.append(algo)
            
            if data:
                parts = ax.violinplot(data, positions=range(1, len(labels)+1), showmeans=True, showmedians=True)
                for i, pc in enumerate(parts['bodies']):
                    pc.set_facecolor(COLORS[labels[i]])
                    pc.set_alpha(0.7)
                ax.set_xticks(range(1, len(labels)+1))
                ax.set_xticklabels(labels, rotation=45)
                ax.set_ylabel(ylabel, fontsize=11, fontweight='bold')
                ax.set_title(f'{metric} Distribution', fontsize=12, fontweight='bold')
                ax.grid(True, alpha=0.3)
        
        plt.suptitle('Algorithm Performance Distribution', fontsize=14, fontweight='bold')
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'violin_plots.pdf', bbox_inches='tight', dpi=300)
        plt.close()
        print("  ✓ Saved: violin_plots.pdf")
    
    def create_radar_chart(self, results_df: pd.DataFrame):
        print("--- Creating Radar Chart ---")
        metrics = {
            'Hypervolume': 'higher',
            'Best_Emissions_kg': 'lower',
            'Pareto_Size': 'higher'
        }
        
        fig, ax = plt.subplots(figsize=(8, 8), subplot_kw=dict(projection='polar'))
        
        for algo in ['En-NSGA-II', 'NSGA-II', 'SPEA2', 'MOEA/D']:
            algo_data = results_df[results_df['Algorithm'] == algo]
            if len(algo_data) == 0:
                continue
            
            values = []
            for metric, direction in metrics.items():
                val = algo_data[metric].mean()
                if direction == 'lower':
                    max_val = results_df[metric].max()
                    val = (max_val - val) / max_val if max_val > 0 else 0
                else:
                    min_val = results_df[metric].min()
                    max_val = results_df[metric].max()
                    val = (val - min_val) / (max_val - min_val) if max_val > min_val else 0.5
                values.append(val)
            
            values.append(values[0])
            angles = np.linspace(0, 2*np.pi, len(metrics), endpoint=False).tolist()
            angles.append(angles[0])
            
            ax.plot(angles, values, 'o-', linewidth=2, label=algo, color=COLORS[algo])
            ax.fill(angles, values, alpha=0.15, color=COLORS[algo])
        
        ax.set_xticks(angles[:-1])
        ax.set_xticklabels(list(metrics.keys()))
        ax.set_ylim(0, 1)
        ax.set_title('Algorithm Performance Radar Chart\n(Higher = Better)', fontsize=12, fontweight='bold', pad=20)
        ax.legend(loc='upper right', bbox_to_anchor=(1.3, 1.0))
        ax.grid(True)
        
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'radar_chart.pdf', bbox_inches='tight', dpi=300)
        plt.close()
        print("  ✓ Saved: radar_chart.pdf")
    
    def create_heatmap(self, results_df: pd.DataFrame):
        print("--- Creating Performance Heatmap ---")
        pivot = results_df.pivot(index='Instance', columns='Algorithm', values='Hypervolume')
        pivot_norm = (pivot - pivot.min()) / (pivot.max() - pivot.min())
        
        fig, ax = plt.subplots(figsize=(12, 10))
        im = ax.imshow(pivot_norm.values, cmap='RdYlGn', aspect='auto')
        ax.set_xticks(range(len(pivot.columns)))
        ax.set_xticklabels(pivot.columns, rotation=45, ha='right')
        ax.set_yticks(range(len(pivot.index)))
        ax.set_yticklabels(pivot.index, fontsize=8)
        ax.set_title('Hypervolume Performance Heatmap (Normalized)', fontsize=12, fontweight='bold')
        ax.set_xlabel('Algorithm')
        ax.set_ylabel('Instance')
        plt.colorbar(im, ax=ax)
        
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'performance_heatmap.pdf', bbox_inches='tight', dpi=300)
        plt.close()
        print("  ✓ Saved: performance_heatmap.pdf")
    
    def create_scatter_plot(self, results_df: pd.DataFrame):
        print("--- Creating Cost-Emissions Scatter Plot ---")
        fig, ax = plt.subplots(figsize=(10, 8))
        
        for algo in ['En-NSGA-II', 'NSGA-II', 'SPEA2', 'MOEA/D']:
            algo_data = results_df[results_df['Algorithm'] == algo]
            if len(algo_data) > 0:
                ax.scatter(algo_data['Best_Cost_USD'], algo_data['Best_Emissions_kg'],
                          c=COLORS[algo], marker=MARKERS[algo], s=100, alpha=0.6, label=algo)
        
        ax.set_xlabel('Best Cost (USD)', fontsize=12, fontweight='bold')
        ax.set_ylabel('Best CO₂ Emissions (kg)', fontsize=12, fontweight='bold')
        ax.set_title('Cost-Emissions Trade-off by Algorithm', fontsize=14, fontweight='bold')
        ax.legend(loc='upper right')
        ax.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'cost_emissions_scatter.pdf', bbox_inches='tight', dpi=300)
        plt.close()
        print("  ✓ Saved: cost_emissions_scatter.pdf")
    
    def create_size_analysis(self, results_df: pd.DataFrame):
        print("--- Creating Size-Based Analysis ---")
        
        def get_size(name):
            if '20-5' in name or 'G20' in name:
                return 'Small (20)'
            elif '50-5' in name or 'G50' in name:
                return 'Medium (50)'
            elif '100' in name:
                return 'Large (100)'
            elif '200' in name:
                return 'Very Large (200)'
            return 'Unknown'
        
        results_df['Size'] = results_df['Instance'].apply(get_size)
        sizes = ['Small (20)', 'Medium (50)', 'Large (100)', 'Very Large (200)']
        
        fig, axes = plt.subplots(2, 2, figsize=(14, 10))
        
        for idx, size in enumerate(sizes):
            ax = axes[idx//2, idx%2]
            size_data = results_df[results_df['Size'] == size]
            
            if len(size_data) > 0:
                data = []
                labels = []
                for algo in ['En-NSGA-II', 'NSGA-II', 'SPEA2', 'MOEA/D']:
                    d = size_data[size_data['Algorithm'] == algo]['Best_Emissions_kg'].values
                    if len(d) > 0:
                        data.append(d)
                        labels.append(algo)
                
                if data:
                    bp = ax.boxplot(data, labels=labels, patch_artist=True, showfliers=False)
                    for patch, label in zip(bp['boxes'], labels):
                        patch.set_facecolor(COLORS[label])
                        patch.set_alpha(0.7)
                    ax.set_ylabel('CO₂ Emissions (kg)', fontsize=10)
                    ax.set_title(f'{size} Customers', fontsize=11, fontweight='bold')
                    ax.grid(True, alpha=0.3)
                    ax.tick_params(axis='x', rotation=45)
        
        plt.suptitle('Algorithm Performance by Instance Size', fontsize=14, fontweight='bold')
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'size_based_analysis.pdf', bbox_inches='tight', dpi=300)
        plt.close()
        print("  ✓ Saved: size_based_analysis.pdf")
    
    def create_all(self, results_df: pd.DataFrame):
        print("\n" + "="*80)
        print(" GENERATING VISUALIZATIONS ".center(80, "="))
        print("="*80)
        self.create_box_plots(results_df)
        self.create_violin_plots(results_df)
        self.create_radar_chart(results_df)
        self.create_heatmap(results_df)
        self.create_scatter_plot(results_df)
        self.create_size_analysis(results_df)
        print(f"\n✓ All plots saved to: {self.plots_dir}/")


