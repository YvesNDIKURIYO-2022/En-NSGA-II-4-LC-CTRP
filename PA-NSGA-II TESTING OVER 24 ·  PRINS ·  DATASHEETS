class NSGAIII(BaseAlgorithm):
    def __init__(self, problem, pop_size=60, n_gen=50, run_id=0, seed=None):
        super().__init__(problem, pop_size, n_gen, "NSGA-III", run_id, seed)
        self.reference_points = self._generate_reference_points()
    
    def _generate_reference_points(self):
        points = []
        p = 4
        for i in range(p + 1):
            for j in range(p + 1 - i):
                k = p - i - j
                points.append([i/p, j/p, k/p])
        ref_points = np.array(points)
        
        if len(ref_points) < self.pop_size:
            extra = self.pop_size - len(ref_points)
            for _ in range(extra):
                perturbed = ref_points[np.random.randint(len(ref_points))] + np.random.normal(0, 0.01, 3)
                perturbed = np.clip(perturbed, 0, 1)
                perturbed = perturbed / (perturbed.sum() + 1e-6)
                ref_points = np.vstack([ref_points, perturbed])
        
        return ref_points[:self.pop_size]
    
    def _normalize_objs(self, objs):
        objs_array = np.array(objs)
        ideal = np.min(objs_array, axis=0)
        translated = objs_array - ideal
        intercepts = np.max(translated, axis=0) + 1e-6
        return translated / intercepts
    
    def _associate_to_reference(self, norm_objs):
        n = len(norm_objs)
        n_ref = len(self.reference_points)
        distances = np.zeros((n, n_ref))
        
        for i, obj in enumerate(norm_objs):
            for j, ref in enumerate(self.reference_points):
                if np.linalg.norm(obj) > 0 and np.linalg.norm(ref) > 0:
                    cos_theta = np.dot(obj, ref) / (np.linalg.norm(obj) * np.linalg.norm(ref))
                    cos_theta = np.clip(cos_theta, -1, 1)
                    theta = np.arccos(cos_theta)
                    distances[i, j] = theta
                else:
                    distances[i, j] = np.inf
        
        closest_ref = np.argmin(distances, axis=1)
        min_distances = np.min(distances, axis=1)
        return closest_ref, min_distances
    
    def init_pop(self) -> List[np.ndarray]:
        return [np.random.rand(self.n_vars) for _ in range(self.pop_size)]
    
    def run(self):
        pop = self.init_pop()
        objs = self.evaluate(pop)
        
        for gen in range(self.n_gen):
            offspring = []
            for _ in range(self.pop_size // 2):
                p1_idx = random.randint(0, len(pop)-1)
                p2_idx = random.randint(0, len(pop)-1)
                c1, c2 = self.crossover(pop[p1_idx], pop[p2_idx])
                c1 = self.mutate(c1)
                c2 = self.mutate(c2)
                offspring.append(c1)
                offspring.append(c2)
            
            off_objs = self.evaluate(offspring)
            combined_pop = pop + offspring
            combined_objs = objs + off_objs
            
            fronts = self.non_dominated_sort(combined_objs)
            
            new_pop, new_objs = [], []
            last_front = 0
            
            for front_idx, front in enumerate(fronts):
                if len(new_pop) + len(front) <= self.pop_size:
                    for idx in front:
                        new_pop.append(combined_pop[idx])
                        new_objs.append(combined_objs[idx])
                else:
                    last_front = front_idx
                    break
            
            remaining = self.pop_size - len(new_pop)
            if remaining > 0 and last_front < len(fronts):
                last_front_indices = fronts[last_front]
                last_front_objs = [combined_objs[idx] for idx in last_front_indices]
                
                all_objs_for_norm = new_objs + last_front_objs
                normalized_objs = self._normalize_objs(all_objs_for_norm)
                norm_last_front = normalized_objs[len(new_objs):]
                
                if new_objs:
                    norm_new = normalized_objs[:len(new_objs)]
                    closest_ref_new, _ = self._associate_to_reference(norm_new)
                    ref_counts = np.bincount(closest_ref_new, minlength=len(self.reference_points))
                else:
                    ref_counts = np.zeros(len(self.reference_points))
                
                closest_ref, distances = self._associate_to_reference(norm_last_front)
                
                selected_indices = []
                for _ in range(remaining):
                    min_count = np.min(ref_counts)
                    eligible_refs = np.where(ref_counts == min_count)[0]
                    
                    best_ref = None
                    for ref in eligible_refs:
                        ref_indices = [i for i, r in enumerate(closest_ref) if r == ref]
                        if ref_indices:
                            best_ref = ref
                            break
                    
                    if best_ref is not None:
                        ref_indices = [i for i, r in enumerate(closest_ref) if r == best_ref]
                        best_idx = min(ref_indices, key=lambda i: distances[i])
                        selected_indices.append(last_front_indices[best_idx])
                        ref_counts[best_ref] += 1
                        
                        last_front_indices = [idx for j, idx in enumerate(last_front_indices) if j != best_idx]
                        last_front_objs = [obj for j, obj in enumerate(last_front_objs) if j != best_idx]
                        norm_last_front = [obj for j, obj in enumerate(norm_last_front) if j != best_idx]
                        closest_ref = [r for j, r in enumerate(closest_ref) if j != best_idx]
                        distances = [d for j, d in enumerate(distances) if j != best_idx]
                
                for idx in selected_indices:
                    new_pop.append(combined_pop[idx])
                    new_objs.append(combined_objs[idx])
            
            pop = new_pop
            objs = new_objs
            
            pareto = self.get_pareto(pop, objs)
            hv = self.calc_hypervolume(pareto)
            diversity = self.calc_diversity(pareto)
            best_emissions = min(o[1] for o in pareto) if pareto else 0
            best_cost = min(o[0] for o in pareto) if pareto else 0
            
            self.history['hv'].append(float(hv))
            self.history['best_emissions'].append(float(best_emissions))
            self.history['best_cost'].append(float(best_cost))
            self.history['diversity'].append(float(diversity))
        
        self.pareto_front = self.get_pareto(pop, objs)
        return {
            'hypervolume': float(self.history['hv'][-1]) if self.history['hv'] else 0.0,
            'best_emissions': float(min(o[1] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'best_cost': float(min(o[0] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'best_time': float(min(o[2] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'pareto_size': int(len(self.pareto_front)),
            'diversity': float(self.history['diversity'][-1]) if self.history['diversity'] else 0.0,
            'history': self.history,
            'pareto_front': self.pareto_front
        }


