class SPEA2(BaseAlgorithm):
    def __init__(self, problem, pop_size=60, n_gen=50, run_id=0, seed=None):
        super().__init__(problem, pop_size, n_gen, "SPEA2", run_id, seed)
        self.archive_size = pop_size
    
    def init_pop(self) -> List[np.ndarray]:
        return [np.random.rand(self.n_vars) for _ in range(self.pop_size)]
    
    def calc_strength(self, objs):
        n = len(objs)
        strength = [0.0] * n
        for i in range(n):
            for j in range(n):
                if i != j and self.dominates(objs[i], objs[j]):
                    strength[i] += 1
        return strength
    
    def calc_raw_fitness(self, objs, strength):
        n = len(objs)
        raw = [0.0] * n
        for i in range(n):
            for j in range(n):
                if j != i and self.dominates(objs[j], objs[i]):
                    raw[i] += strength[j]
        return raw
    
    def calc_density(self, objs, k=1):
        n = len(objs)
        if n <= 1:
            return [0.0] * n
        dist = np.zeros((n, n))
        for i in range(n):
            for j in range(n):
                if i != j:
                    dist[i, j] = np.sqrt((objs[i][0]-objs[j][0])**2 + (objs[i][1]-objs[j][1])**2 + (objs[i][2]-objs[j][2])**2)
        density = []
        for i in range(n):
            sorted_dist = sorted(dist[i])
            kth = sorted_dist[min(k, len(sorted_dist)-1)] if sorted_dist else 0
            density.append(1 / (kth + 2))
        return density
    
    def run(self):
        pop = self.init_pop()
        objs = self.evaluate(pop)
        archive, archive_objs = [], []
        
        for gen in range(self.n_gen):
            combined_pop = archive + pop
            combined_objs = archive_objs + objs
            
            if combined_objs:
                strength = self.calc_strength(combined_objs)
                raw_fitness = self.calc_raw_fitness(combined_objs, strength)
                density = self.calc_density(combined_objs)
                fitness = [raw_fitness[i] + density[i] for i in range(len(combined_objs))]
                
                sorted_idx = sorted(range(len(combined_objs)), key=lambda i: fitness[i])
                new_archive, new_archive_objs = [], []
                for idx in sorted_idx:
                    if len(new_archive) < self.archive_size:
                        new_archive.append(combined_pop[idx])
                        new_archive_objs.append(combined_objs[idx])
                    else:
                        break
                archive, archive_objs = new_archive, new_archive_objs
            
            if len(archive) >= 2:
                offspring = []
                for _ in range(self.pop_size // 2):
                    p1 = random.choice(archive)
                    p2 = random.choice(archive)
                    c1, c2 = self.crossover(p1, p2)
                    c1 = self.mutate(c1)
                    c2 = self.mutate(c2)
                    offspring.append(c1)
                    offspring.append(c2)
                pop = offspring[:self.pop_size]
                objs = self.evaluate(pop)
            
            if archive:
                pareto = self.get_pareto(archive, archive_objs)
                hv = self.calc_hypervolume(pareto)
                diversity = self.calc_diversity(pareto)
                best_emissions = min(o[1] for o in pareto) if pareto else 0
                best_cost = min(o[0] for o in pareto) if pareto else 0
            else:
                hv, diversity, best_emissions, best_cost = 0, 0, 0, 0
            
            self.history['hv'].append(float(hv))
            self.history['best_emissions'].append(float(best_emissions))
            self.history['best_cost'].append(float(best_cost))
            self.history['diversity'].append(float(diversity))
        
        self.pareto_front = self.get_pareto(archive, archive_objs) if archive else []
        return {
            'hypervolume': float(self.history['hv'][-1]) if self.history['hv'] else 0.0,
            'best_emissions': float(min(o[1] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'best_cost': float(min(o[0] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'best_time': float(min(o[2] for o in self.pareto_front)) if self.pareto_front else 0.0,
            'pareto_size': int(len(self.pareto_front)),
            'diversity': float(self.history['diversity'][-1]) if self.history['diversity'] else 0.0,
            'history': self.history,
            'pareto_front': self.pareto_front
        }


