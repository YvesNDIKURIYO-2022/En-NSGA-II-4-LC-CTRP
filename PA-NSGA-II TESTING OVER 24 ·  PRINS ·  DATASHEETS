# BASE ALGORITHM CLASS
# ============================================================================

class BaseAlgorithm:
    def __init__(self, problem, pop_size: int = 60, n_gen: int = 50, name: str = "Algorithm"):
        self.problem = problem
        self.pop_size = pop_size
        self.n_gen = n_gen
        self.name = name
        self.n_vars = problem.n_vars
        self.crossover_rate = 0.9
        self.mutation_rate = 0.1
        self.mutation_strength = 0.1
        self.history = {'hv': [], 'best_emissions': []}
    
    def init_pop(self) -> List[np.ndarray]:
        return [np.random.rand(self.n_vars) for _ in range(self.pop_size)]
    
    def evaluate(self, pop: List[np.ndarray]) -> List[Tuple[float, float]]:
        return [self.problem.evaluate(ind) for ind in pop]
    
    def dominates(self, a: Tuple[float, float], b: Tuple[float, float]) -> bool:
        return (a[0] <= b[0] and a[1] <= b[1] and (a[0] < b[0] or a[1] < b[1]))
    
    def crossover(self, p1: np.ndarray, p2: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        if random.random() > self.crossover_rate:
            return p1.copy(), p2.copy()
        alpha = np.random.rand(len(p1))
        c1 = alpha * p1 + (1 - alpha) * p2
        c2 = alpha * p2 + (1 - alpha) * p1
        return np.clip(c1, 0, 1), np.clip(c2, 0, 1)
    
    def mutate(self, ind: np.ndarray) -> np.ndarray:
        if random.random() > self.mutation_rate:
            return ind
        child = ind.copy()
        mask = np.random.rand(len(child)) < 0.1
        child[mask] += np.random.normal(0, self.mutation_strength, np.sum(mask))
        return np.clip(child, 0, 1)
    
    def non_dominated_sort(self, objs: List[Tuple[float, float]]) -> List[List[int]]:
        n = len(objs)
        dominated = [[] for _ in range(n)]
        dom_count = [0] * n
        for i in range(n):
            for j in range(n):
                if i != j:
                    if self.dominates(objs[i], objs[j]):
                        dominated[i].append(j)
                    elif self.dominates(objs[j], objs[i]):
                        dom_count[i] += 1
        fronts = []
        current = [i for i in range(n) if dom_count[i] == 0]
        while current:
            fronts.append(current)
            next_front = []
            for i in current:
                for j in dominated[i]:
                    dom_count[j] -= 1
                    if dom_count[j] == 0:
                        next_front.append(j)
            current = next_front
        return fronts
    
    def crowding_distance(self, objs: List[Tuple[float, float]], front: List[int]) -> List[float]:
        n = len(front)
        if n <= 2:
            return [float('inf')] * n
        dist = [0.0] * n
        front_objs = [objs[i] for i in front]
        for m in range(2):
            sorted_idx = sorted(range(n), key=lambda k: front_objs[k][m])
            min_val = front_objs[sorted_idx[0]][m]
            max_val = front_objs[sorted_idx[-1]][m]
            rng = max_val - min_val
            dist[sorted_idx[0]] = float('inf')
            dist[sorted_idx[-1]] = float('inf')
            if rng > 0:
                for k in range(1, n-1):
                    dist[sorted_idx[k]] += (front_objs[sorted_idx[k+1]][m] - front_objs[sorted_idx[k-1]][m]) / rng
        return dist
    
    def get_pareto(self, pop: List[np.ndarray], objs: List[Tuple[float, float]]) -> List[Tuple[float, float]]:
        n = len(objs)
        pareto = []
        for i in range(n):
            dominated = False
            for j in range(n):
                if i != j and self.dominates(objs[j], objs[i]):
                    dominated = True
                    break
            if not dominated:
                pareto.append(objs[i])
        return list(set(pareto))
    
    def calc_hypervolume(self, pareto: List[Tuple[float, float]]) -> float:
        if len(pareto) < 2:
            return 0.0
        max_f1 = max(p[0] for p in pareto) * 1.1
        max_f2 = max(p[1] for p in pareto) * 1.1
        sorted_p = sorted(pareto, key=lambda x: x[0])
        hv = 0.0
        prev_f1 = sorted_p[0][0]
        for f1, f2 in sorted_p:
            if f1 > prev_f1:
                min_f2 = min(p[1] for p in sorted_p if p[0] >= f1)
                hv += (f1 - prev_f1) * (max_f2 - min_f2)
                prev_f1 = f1
        return hv / (max_f1 * max_f2) if max_f1 * max_f2 > 0 else 0
    
    def tournament(self, pop, objs, ranks, crowding):
        i = random.randint(0, len(pop)-1)
        j = random.randint(0, len(pop)-1)
        if ranks[i] < ranks[j]:
            return pop[i].copy()
        elif ranks[i] > ranks[j]:
            return pop[j].copy()
        else:
            return pop[i].copy() if crowding[i] > crowding[j] else pop[j].copy()
    
    def run(self):
        raise NotImplementedError


