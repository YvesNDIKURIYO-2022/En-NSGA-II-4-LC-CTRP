class MOEAD(BaseAlgorithm):
    def __init__(self, problem, pop_size=60, n_gen=50):
        super().__init__(problem, pop_size, n_gen, "MOEA/D")
        self.n_neighbors = 20
    
    def generate_weights(self):
        weights = []
        for i in range(self.pop_size):
            w1 = i / (self.pop_size - 1) if self.pop_size > 1 else 0.5
            weights.append([w1, 1 - w1])
        return np.array(weights)
    
    def compute_neighbors(self, weights):
        n = len(weights)
        dist = np.zeros((n, n))
        for i in range(n):
            for j in range(n):
                dist[i, j] = np.linalg.norm(weights[i] - weights[j])
        neighbors = []
        for i in range(n):
            neighbors.append(np.argsort(dist[i])[:min(self.n_neighbors, n)])
        return neighbors
    
    def tchebycheff(self, obj, weight, ideal):
        return max(weight[0] * abs(obj[0] - ideal[0]), weight[1] * abs(obj[1] - ideal[1]))
    
    def run(self):
        print(f"\n--- Running {self.name} ---")
        weights = self.generate_weights()
        neighbors = self.compute_neighbors(weights)
        
        pop = self.init_pop()
        objs = self.evaluate(pop)
        ideal = (min(o[0] for o in objs), min(o[1] for o in objs))
        
        for gen in range(self.n_gen):
            for i in range(self.pop_size):
                neighbor_indices = neighbors[i]
                p1 = random.choice(neighbor_indices)
                p2 = random.choice(neighbor_indices)
                c1, _ = self.crossover(pop[p1], pop[p2])
                child = self.mutate(c1)
                child_obj = self.problem.evaluate(child)
                
                ideal = (min(ideal[0], child_obj[0]), min(ideal[1], child_obj[1]))
                
                for j in neighbor_indices:
                    old_val = self.tchebycheff(objs[j], weights[j], ideal)
                    new_val = self.tchebycheff(child_obj, weights[j], ideal)
                    if new_val < old_val:
                        pop[j] = child.copy()
                        objs[j] = child_obj
            
            pareto = self.get_pareto(pop, objs)
            hv = self.calc_hypervolume(pareto)
            best_emissions = min(o[1] for o in pareto) if pareto else 0
            
            self.history['hv'].append(hv)
            self.history['best_emissions'].append(best_emissions)
            
            if gen % 20 == 0 or gen == self.n_gen - 1:
                print(f"Gen {gen:3d}: HV={hv:.4f}, Best CO₂={best_emissions:.1f}kg")
        
        pareto = self.get_pareto(pop, objs)
        return {
            'hypervolume': self.history['hv'][-1] if self.history['hv'] else 0,
            'best_emissions': min(o[1] for o in pareto) if pareto else 0,
            'best_cost': min(o[0] for o in pareto) if pareto else 0,
            'pareto_size': len(pareto)
        }


