class BaseAlgorithm:
    def __init__(self, problem, pop_size: int = 60, n_gen: int = 50, name: str = "Algorithm", run_id: int = 0, seed: int = None):
        self.problem = problem
        self.pop_size = pop_size
        self.n_gen = n_gen
        self.name = name
        self.run_id = run_id
        self.seed = seed
        self.n_vars = problem.n_vars
        self.crossover_rate = 0.85
        self.mutation_rate = 0.12
        self.mutation_strength = 0.1
        self.history = {'hv': [], 'best_emissions': [], 'best_cost': [], 'diversity': []}
        self.pareto_front = []
        self.archive = []
        self.archive_size = pop_size
        
        if seed is not None:
            random.seed(seed)
            np.random.seed(seed)
    
    def init_pop(self) -> List[np.ndarray]:
        return [np.random.rand(self.n_vars) for _ in range(self.pop_size)]
    
    def evaluate(self, pop: List[np.ndarray]) -> List[Tuple[float, float, float]]:
        return [self.problem.evaluate(ind) for ind in pop]
    
    def dominates(self, a: Tuple[float, float, float], b: Tuple[float, float, float]) -> bool:
        return (a[0] <= b[0] and a[1] <= b[1] and a[2] <= b[2] and
                (a[0] < b[0] or a[1] < b[1] or a[2] < b[2]))
    
    def crossover(self, p1: np.ndarray, p2: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        if random.random() > self.crossover_rate:
            return p1.copy(), p2.copy()
        alpha = np.random.rand(len(p1))
        c1 = alpha * p1 + (1 - alpha) * p2
        c2 = alpha * p2 + (1 - alpha) * p1
        return np.clip(c1, 0, 1), np.clip(c2, 0, 1)
    
    def mutate(self, ind: np.ndarray) -> np.ndarray:
        if random.random() > self.mutation_rate:
            return ind
        child = ind.copy()
        mask = np.random.rand(len(child)) < 0.1
        child[mask] += np.random.normal(0, self.mutation_strength, np.sum(mask))
        return np.clip(child, 0, 1)
    
    def local_search(self, ind: np.ndarray) -> np.ndarray:
        improved = ind.copy()
        current_emissions = self.problem.evaluate(ind)[1]
        
        for _ in range(15):
            neighbor = improved.copy()
            i, j = random.sample(range(len(neighbor)), 2)
            neighbor[i], neighbor[j] = neighbor[j], neighbor[i]
            
            new_emissions = self.problem.evaluate(neighbor)[1]
            if new_emissions < current_emissions * 0.98:
                improved = neighbor
                current_emissions = new_emissions
        
        return improved
    
    def non_dominated_sort(self, objs: List[Tuple[float, float, float]]) -> List[List[int]]:
        n = len(objs)
        dominated = [[] for _ in range(n)]
        dom_count = [0] * n
        for i in range(n):
            for j in range(n):
                if i != j:
                    if self.dominates(objs[i], objs[j]):
                        dominated[i].append(j)
                    elif self.dominates(objs[j], objs[i]):
                        dom_count[i] += 1
        fronts = []
        current = [i for i in range(n) if dom_count[i] == 0]
        while current:
            fronts.append(current)
            next_front = []
            for i in current:
                for j in dominated[i]:
                    dom_count[j] -= 1
                    if dom_count[j] == 0:
                        next_front.append(j)
            current = next_front
        return fronts
    
    def crowding_distance(self, objs: List[Tuple[float, float, float]], front: List[int]) -> List[float]:
        n = len(front)
        if n <= 2:
            return [float('inf')] * n
        dist = [0.0] * n
        front_objs = [objs[i] for i in front]
        for m in range(3):
            sorted_idx = sorted(range(n), key=lambda k: front_objs[k][m])
            min_val = front_objs[sorted_idx[0]][m]
            max_val = front_objs[sorted_idx[-1]][m]
            rng = max_val - min_val
            dist[sorted_idx[0]] = float('inf')
            dist[sorted_idx[-1]] = float('inf')
            if rng > 0:
                for k in range(1, n-1):
                    dist[sorted_idx[k]] += (front_objs[sorted_idx[k+1]][m] - front_objs[sorted_idx[k-1]][m]) / rng
        return dist
    
    def get_pareto(self, pop: List[np.ndarray], objs: List[Tuple[float, float, float]]) -> List[Tuple[float, float, float]]:
        n = len(objs)
        pareto = []
        for i in range(n):
            dominated = False
            for j in range(n):
                if i != j and self.dominates(objs[j], objs[i]):
                    dominated = True
                    break
            if not dominated:
                pareto.append(objs[i])
        return list(set(pareto))
    
    def calc_hypervolume(self, pareto: List[Tuple[float, float, float]]) -> float:
        if len(pareto) < 2:
            return 0.0
        try:
            return exact_hypervolume_3d(pareto, (1e9, 1e9, 1e9))
        except:
            return 0.0
    
    def calc_diversity(self, pareto: List[Tuple[float, float, float]]) -> float:
        if len(pareto) < 2:
            return 0.0
        pareto_array = np.array(pareto)
        centroid = np.mean(pareto_array, axis=0)
        distances = np.linalg.norm(pareto_array - centroid, axis=1)
        return np.std(distances) / (np.mean(distances) + 1e-6)
    
    def tournament(self, pop, objs, ranks, crowding):
        i = random.randint(0, len(pop)-1)
        j = random.randint(0, len(pop)-1)
        if ranks[i] < ranks[j]:
            return pop[i].copy()
        elif ranks[i] > ranks[j]:
            return pop[j].copy()
        else:
            return pop[i].copy() if crowding[i] > crowding[j] else pop[j].copy()
    
    def update_archive(self, pop: List[np.ndarray], objs: List[Tuple[float, float, float]]):
        combined = list(zip(pop, objs))
        non_dominated = []
        for i, (ind_i, obj_i) in enumerate(combined):
            dominated = False
            for j, (_, obj_j) in enumerate(combined):
                if i != j and self.dominates(obj_j, obj_i):
                    dominated = True
                    break
            if not dominated:
                non_dominated.append((ind_i.copy(), obj_i))
        
        non_dominated.sort(key=lambda x: x[1][0] + x[1][1] + x[1][2])
        self.archive = [ind for ind, _ in non_dominated[:self.archive_size]]
    
    def run(self):
        raise NotImplementedError


