class EnhancedNSGAII(BaseAlgorithm):
    def __init__(self, problem, pop_size=60, n_gen=50):
        super().__init__(problem, pop_size, n_gen, "En-NSGA-II")
    
    def init_pop(self) -> List[np.ndarray]:
        pop = []
        depot_costs = self.problem.depot_fixed_costs
        best_depots = np.argsort(depot_costs)[:max(1, self.problem.n_depots // 2)]
        best_values = [d / self.problem.n_depots for d in best_depots]
        
        for i in range(self.pop_size):
            ind = np.random.rand(self.n_vars)
            if i < self.pop_size * 0.3 and best_values:
                for bv in best_values:
                    mask = np.random.rand(self.n_vars) < 0.2
                    ind[mask] = bv + np.random.normal(0, 0.05, np.sum(mask))
                    ind = np.clip(ind, 0, 0.99)
            pop.append(ind)
        return pop
    
    def run(self):
        print(f"\n--- Running {self.name} ---")
        pop = self.init_pop()
        objs = self.evaluate(pop)
        
        for gen in range(self.n_gen):
            fronts = self.non_dominated_sort(objs)
            ranks = [-1] * len(pop)
            crowding = [0.0] * len(pop)
            for i, front in enumerate(fronts):
                dists = self.crowding_distance(objs, front)
                for j, idx in enumerate(front):
                    ranks[idx] = i
                    crowding[idx] = dists[j]
            
            offspring = []
            for _ in range(self.pop_size // 2):
                p1 = self.tournament(pop, objs, ranks, crowding)
                p2 = self.tournament(pop, objs, ranks, crowding)
                c1, c2 = self.crossover(p1, p2)
                offspring.append(self.mutate(c1))
                offspring.append(self.mutate(c2))
            
            off_objs = self.evaluate(offspring)
            combined_pop = pop + offspring
            combined_objs = objs + off_objs
            combined_fronts = self.non_dominated_sort(combined_objs)
            
            new_pop, new_objs = [], []
            for front in combined_fronts:
                if len(new_pop) + len(front) <= self.pop_size:
                    for idx in front:
                        new_pop.append(combined_pop[idx])
                        new_objs.append(combined_objs[idx])
                else:
                    dists = self.crowding_distance(combined_objs, front)
                    front_with_dist = [(idx, dists[j]) for j, idx in enumerate(front)]
                    front_with_dist.sort(key=lambda x: -x[1])
                    needed = self.pop_size - len(new_pop)
                    for idx, _ in front_with_dist[:needed]:
                        new_pop.append(combined_pop[idx])
                        new_objs.append(combined_objs[idx])
                    break
            
            pop, objs = new_pop, new_objs
            pareto = self.get_pareto(pop, objs)
            hv = self.calc_hypervolume(pareto)
            best_emissions = min(o[1] for o in pareto) if pareto else 0
            
            self.history['hv'].append(hv)
            self.history['best_emissions'].append(best_emissions)
            
            if gen % 20 == 0 or gen == self.n_gen - 1:
                print(f"Gen {gen:3d}: HV={hv:.4f}, Best CO₂={best_emissions:.1f}kg")
        
        pareto = self.get_pareto(pop, objs)
        return {
            'hypervolume': self.history['hv'][-1] if self.history['hv'] else 0,
            'best_emissions': min(o[1] for o in pareto) if pareto else 0,
            'best_cost': min(o[0] for o in pareto) if pareto else 0,
            'pareto_size': len(pareto)
        }


