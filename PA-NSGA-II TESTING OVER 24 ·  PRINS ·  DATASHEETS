        axes[1].set_xlabel('Variant', fontsize=12)
        axes[1].set_title('Ablation Study: Cost Comparison', fontsize=12)
        axes[1].tick_params(axis='x', rotation=45)
        
        plt.suptitle('PA-NSGA-II Ablation Study: Component Contributions', fontsize=14)
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'ablation_study.pdf', dpi=300, bbox_inches='tight')
        plt.close()
        print("  Saved: ablation_study.pdf")
    
    def create_all(self, results_df: pd.DataFrame, ablation_results: Dict = None):
        print("\n" + "="*80)
        print(" GENERATING ENHANCED VISUALIZATIONS ".center(80, "="))
        print("="*80)
        self.create_variance_analysis_plot(results_df)
