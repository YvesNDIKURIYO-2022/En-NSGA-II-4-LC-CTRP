# EXACT HYPERVOLUME CALCULATION
# ============================================================================

def exact_hypervolume_2d(points: List[Tuple[float, float]], reference: Tuple[float, float]) -> float:
    if not points:
        return 0.0
    
    non_dominated = []
    for i, p in enumerate(points):
        dominated = False
        for j, q in enumerate(points):
            if i != j and q[0] <= p[0] and q[1] <= p[1] and (q[0] < p[0] or q[1] < p[1]):
                dominated = True
                break
        if not dominated:
            non_dominated.append(p)
    
    sorted_points = sorted(non_dominated, key=lambda x: x[0])
    
    hv = 0.0
    prev_x = sorted_points[0][0]
    prev_y = sorted_points[0][1]
    
    for i in range(1, len(sorted_points)):
        x = sorted_points[i][0]
        y = sorted_points[i][1]
        
        if y < prev_y:
            hv += (x - prev_x) * (reference[1] - prev_y)
            prev_x = x
            prev_y = y
    
    hv += (reference[0] - prev_x) * (reference[1] - prev_y)
    return max(0.0, hv)


def exact_hypervolume_3d(points: List[Tuple[float, float, float]], 
                         reference: Tuple[float, float, float]) -> float:
    if not points:
        return 0.0
    
    non_dominated = []
    for i, p in enumerate(points):
        dominated = False
        for j, q in enumerate(points):
            if i != j:
                if q[0] <= p[0] and q[1] <= p[1] and q[2] <= p[2] and \
                   (q[0] < p[0] or q[1] < p[1] or q[2] < p[2]):
                    dominated = True
                    break
        if not dominated:
            non_dominated.append(p)
    
    if not non_dominated:
        return 0.0
    
    sorted_points = sorted(non_dominated, key=lambda x: x[0])
    
    def hypervolume_recursive(points_list, ref, dim=0):
        if not points_list:
            return 0.0
        
        if dim == 2:
            return exact_hypervolume_2d([(p[0], p[1]) for p in points_list], (ref[0], ref[1]))
        
        sorted_pts = sorted(points_list, key=lambda x: x[dim])
        
        hv = 0.0
        prev = sorted_pts[0][dim]
        
        for i, pt in enumerate(sorted_pts):
            current = pt[dim]
            if current > prev:
                slice_pts = [p for p in sorted_pts if p[dim] <= current]
                slice_ref = list(ref)
                slice_ref[dim] = current
                
                hv += (current - prev) * hypervolume_recursive(slice_pts, tuple(slice_ref), dim + 1)
                prev = current
        
        return hv
    
    max_obj = [max(p[i] for p in non_dominated) for i in range(3)]
    ref_point = (max_obj[0] * 1.1, max_obj[1] * 1.1, max_obj[2] * 1.1)
    
    return hypervolume_recursive(non_dominated, ref_point, 0)


