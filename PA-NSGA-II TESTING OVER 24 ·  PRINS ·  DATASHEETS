class PrinsProblem:
    def __init__(self, instance_data: Dict, carbon_price: float = 500.0):
        self.instance = instance_data
        self.carbon_price = carbon_price / 1000.0
        self.name = f"Prins_{instance_data['name']}"
        self.emission_cap = 300.0
        
        self.n_depots = instance_data['n_depots']
        self.n_customers = instance_data['n_customers']
        self.n_vars = self.n_customers
        self.n_obj = 3
        
        self.emission_factor = instance_data.get('emission_factor', 0.120)
        self.fuel_cost = instance_data.get('fuel_cost', 0.23)
        self.vehicle_capacity = instance_data.get('vehicle_capacity', 150)
        self.route_fixed_cost = instance_data.get('route_fixed_cost', 1000)
        
        self.depot_coords = [(d['x'], d['y']) for d in instance_data['depots']]
        self.depot_fixed_costs = [d['fixed_cost'] for d in instance_data['depots']]
        self.customer_coords = [(c['x'], c['y']) for c in instance_data['customers']]
        self.demands = [c['demand'] for c in instance_data['customers']]
        
        self.speeds = {'road': 70, 'rail': 60, 'water': 22.5}
        
        if self.n_depots > 0 and self.n_customers > 0:
            all_coords = self.depot_coords + self.customer_coords
            self.distances = cdist(all_coords, all_coords, metric='euclidean')
        else:
            self.distances = np.zeros((1, 1))
    
    def decode(self, x: np.ndarray) -> Dict:
        if self.n_depots == 0:
            return {'depot_customers': {}, 'active_depots': []}
        assignments = (x[:self.n_customers] * self.n_depots).astype(int)
        assignments = np.clip(assignments, 0, self.n_depots - 1)
        depot_customers = {i: [] for i in range(self.n_depots)}
        for cust_idx, depot_idx in enumerate(assignments):
            depot_customers[depot_idx].append(cust_idx)
        return {'depot_customers': depot_customers,
                'active_depots': [d for d in range(self.n_depots) if depot_customers[d]]}
    
    def evaluate_route(self, depot_idx: int, customers: List[int]) -> Tuple[float, float, float]:
        if not customers:
            return 0.0, 0.0, 0.0
        total_demand = sum(self.demands[c] for c in customers)
        if total_demand > self.vehicle_capacity:
            penalty = 1e5 * (total_demand / self.vehicle_capacity) ** 2
            return penalty, penalty, penalty
        
        depot_node = depot_idx
        cust_nodes = [self.n_depots + c for c in customers]
        
        route = [depot_node]
        remaining = cust_nodes.copy()
        current = depot_node
        while remaining:
            dists = [self.distances[current, n] for n in remaining]
            nearest = np.argmin(dists)
            current = remaining.pop(nearest)
            route.append(current)
        route.append(depot_node)
        
        total_dist = sum(self.distances[route[i], route[i+1]] for i in range(len(route)-1))
        transport_cost = total_dist * self.fuel_cost
        emissions = total_dist * self.emission_factor
        time_hours = total_dist / self.speeds['road']
        
        return transport_cost + self.route_fixed_cost, emissions, time_hours
    
    def evaluate(self, x: np.ndarray) -> Tuple[float, float, float]:
        if self.n_depots == 0 or self.n_customers == 0:
            return 1e6, 1e6, 1e6
        
        decoded = self.decode(x)
        total_cost = 0.0
        total_emissions = 0.0
        total_time = 0.0
        
        for depot_idx in decoded['active_depots']:
            total_cost += self.depot_fixed_costs[depot_idx]
        
        for depot_idx, customers in decoded['depot_customers'].items():
            if not customers:
                continue
            remaining = customers.copy()
            while remaining:
                route_customers = []
                current_demand = 0
                depot_node = depot_idx
                customers_with_dist = [(c, self.distances[depot_node, self.n_depots + c]) for c in remaining]
                customers_with_dist.sort(key=lambda t: t[1])
                for cust, _ in customers_with_dist:
                    if current_demand + self.demands[cust] <= self.vehicle_capacity:
                        route_customers.append(cust)
                        current_demand += self.demands[cust]
                if route_customers:
                    cost, emissions, time_hours = self.evaluate_route(depot_idx, route_customers)
                    total_cost += cost
                    total_emissions += emissions
                    total_time += time_hours
                    for cust in route_customers:
                        remaining.remove(cust)
                else:
                    break
        
        emission_penalty = 0
        if total_emissions > self.emission_cap:
            emission_penalty = 1e6 * (total_emissions / self.emission_cap) ** 2
        
        total_cost_with_carbon = total_cost + total_emissions * self.carbon_price + emission_penalty
        
        return total_cost_with_carbon, total_emissions, total_time


