class EnhancedStatisticalAnalyzer:
    def __init__(self, results_df: pd.DataFrame):
        self.results = results_df
        self.algorithms = ALGORITHMS
        self.z_score = Z_SCORE
        self.min_effect_size = MIN_EFFECT_SIZE
    
    def compute_confidence_interval(self, data: List[float]) -> Tuple[float, float, float]:
        if not data or len(data) < 2:
            return np.nan, np.nan, np.nan
        mean = np.mean(data)
        std = np.std(data, ddof=1)
        n = len(data)
        margin = self.z_score * (std / np.sqrt(n))
        return mean, mean - margin, mean + margin
    
    def cohens_d(self, data1: List[float], data2: List[float]) -> float:
        if len(data1) < 2 or len(data2) < 2:
            return 0.0
        mean1, mean2 = np.mean(data1), np.mean(data2)
        std1, std2 = np.std(data1, ddof=1), np.std(data2, ddof=1)
        n1, n2 = len(data1), len(data2)
        pooled_std = np.sqrt(((n1 - 1) * std1**2 + (n2 - 1) * std2**2) / (n1 + n2 - 2))
        if pooled_std == 0:
            return 0.0
        return abs(mean1 - mean2) / pooled_std
    
    def interpret_effect_size(self, d: float) -> str:
        if d < 0.2:
            return "negligible"
        elif d < 0.5:
            return "small"
        elif d < 0.8:
            return "medium"
        else:
            return "large"
    
    def coefficient_of_variation(self, data: List[float]) -> float:
        mean_val = np.mean(data)
        if mean_val == 0:
            return float('inf')
        return np.std(data, ddof=1) / mean_val
    
    def success_rate(self, pa_data: List[float], other_data: List[float]) -> float:
        min_len = min(len(pa_data), len(other_data))
        pa_data = pa_data[:min_len]
        other_data = other_data[:min_len]
        better_count = sum(1 for p, o in zip(pa_data, other_data) if p > o)
        return better_count / len(pa_data) * 100
    
    def run_all_tests(self):
        print("\n" + "="*80)
        print(" ENHANCED STATISTICAL SIGNIFICANCE TESTS ".center(80, "="))
        print("="*80)
        
        hv_data = {algo: [] for algo in self.algorithms}
        
        for algo in self.algorithms:
            algo_results = self.results[self.results['Algorithm'] == algo]
            hv_data[algo] = [x for x in algo_results['Hypervolume'] if not np.isnan(x) and x > 0]
        
        print(f"\n--- Sample Sizes (N_RUNS={N_RUNS}) ---")
        for algo in self.algorithms:
            cv = self.coefficient_of_variation(hv_data[algo]) if hv_data[algo] else float('inf')
            print(f"{algo}: n={len(hv_data[algo])}, CV={cv:.3f}")
        
        print(f"\n--- Mann-Whitney U Tests with Effect Sizes ---")
        print(f"{'Comparison':<25} {'p-value':<12} {'Significant':<12} {'Cohen\'s d':<12} {'Interpretation':<15} {'Success Rate'}")
        print("-"*85)
        
        for algo in self.algorithms[1:]:
            d1 = hv_data['PA-NSGA-II']
            d2 = hv_data[algo]
            if len(d1) > 0 and len(d2) > 0:
                try:
                    _, p = mannwhitneyu(d1, d2, alternative='two-sided')
                    sig = "YES" if p < ALPHA else "NO"
                    d = self.cohens_d(d1, d2)
                    interpretation = self.interpret_effect_size(d)
                    success = self.success_rate(d1, d2)
                    
                    practical = "✓ PRACTICAL" if d >= self.min_effect_size else "✗ NOT PRACTICAL"
                    
                    print(f"PA-NSGA-II vs {algo:<15} {p:<12.4f} {sig:<12} {d:<12.3f} {interpretation:<15} {success:.1f}%")
                    print(f"  → {practical}")
                except Exception as e:
                    print(f"PA-NSGA-II vs {algo:<15} Error: {str(e)[:30]}")
        
        print(f"\n--- Kruskal-Wallis Test (Global Comparison) ---")
        algo_lists = [hv_data[a] for a in self.algorithms if len(hv_data[a]) > 0]
        if len(algo_lists) >= 2:
            try:
                stat, p = kruskal(*algo_lists)
                print(f"Hypervolume: H={stat:.4f}, p={p:.4f}, {'SIGNIFICANT' if p < ALPHA else 'NOT SIGNIFICANT'}")
            except:
                print("Kruskal-Wallis test failed")
        
        return hv_data
    
    def generate_validation_report(self, output_path: Path) -> Dict:
        hv_data = {algo: self.results[self.results['Algorithm'] == algo]['Hypervolume'].dropna().tolist() 
                   for algo in self.algorithms}
        
        report = {
            'algorithm_comparison': {},
            'consistency_metrics': {},
            'practical_significance': {}
        }
        
        for algo in self.algorithms:
            data = hv_data[algo]
            if data:
                report['consistency_metrics'][algo] = {
                    'mean': float(np.mean(data)),
                    'std': float(np.std(data, ddof=1)),
                    'cv': float(self.coefficient_of_variation(data)),
                    'iqr': float(np.percentile(data, 75) - np.percentile(data, 25)),
                    'min': float(np.min(data)),
                    'max': float(np.max(data))
                }
        
        for algo in self.algorithms[1:]:
            d1 = hv_data['PA-NSGA-II']
            d2 = hv_data[algo]
            if d1 and d2:
                d = self.cohens_d(d1, d2)
                report['algorithm_comparison'][f'PA-NSGA-II_vs_{algo}'] = {
                    'cohens_d': float(d),
                    'interpretation': self.interpret_effect_size(d),
                    'practical_significant': bool(d >= self.min_effect_size),
                    'success_rate': float(self.success_rate(d1, d2))
                }
        
        with open(output_path / 'validation_report.json', 'w') as f:
            json.dump(report, f, indent=2, default=lambda x: float(x) if hasattr(x, 'item') else x)
        
        print("\n" + "="*80)
        print(" VALIDATION SUMMARY ".center(80, "="))
        print("="*80)
        
        print("\n📊 CONSISTENCY METRICS (Lower CV = More Consistent):")
        for algo, metrics in report['consistency_metrics'].items():
            print(f"  {algo}: CV={metrics['cv']:.3f}, IQR={metrics['iqr']:.2f}")
        
        print("\n🎯 PRACTICAL SIGNIFICANCE (Cohen's d ≥ 0.5 = Meaningful):")
        for comp, metrics in report['algorithm_comparison'].items():
            status = "✅ VALIDATED" if metrics['practical_significant'] else "❌ NOT VALIDATED"
            print(f"  {comp}: d={metrics['cohens_d']:.3f} ({metrics['interpretation']}) - {status}")
        
        return report


