def main():
    print("\n" + "█"*100)
    print(" COMPLETE SINGLE-RUN BENCHMARK ".center(100, "█"))
    print("█"*100)
    print(f"\nStarted: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    
    if not EXCEL_PATH.exists():
        print(f"\n❌ Excel file not found at: {EXCEL_PATH}")
        print("\nPlease update the EXCEL_PATH variable at the top of the script.")
        return
    
    # Load all sheets
    loader = PrinsExcelLoader(str(EXCEL_PATH))
    all_sheets = loader.get_all_sheets()
    print(f"\n📊 Found {len(all_sheets)} sheets in Excel file")
    
    # Filter valid sheets (with depots and customers)
    valid_sheets = []
    for sheet in all_sheets:
        try:
            instance = loader.load_instance(sheet)
            if instance['n_depots'] > 0 and instance['n_customers'] >= 10:
                valid_sheets.append(sheet)
                print(f"   ✅ {sheet}: {instance['n_depots']} depots, {instance['n_customers']} customers")
        except Exception as e:
            print(f"   ❌ {sheet}: Error - {str(e)[:50]}")
    
    print(f"\n📊 Testing {len(valid_sheets)} valid instances")
    
    all_results = []
    
    for sheet_name in valid_sheets:
        print("\n" + "="*80)
        print(f" INSTANCE: {sheet_name} ".center(80, "="))
        print("="*80)
        
        try:
            instance_data = loader.load_instance(sheet_name)
            print(f"  {instance_data['n_depots']} depots, {instance_data['n_customers']} customers")
            print(f"  Vehicle capacity: {instance_data['vehicle_capacity']}")
            
            # Adjust params based on size
            if instance_data['n_customers'] > 100:
                pop, gen = 40, 30
            elif instance_data['n_customers'] > 50:
                pop, gen = 50, 40
            else:
                pop, gen = 50, 40
            
            print(f"  Population: {pop}, Generations: {gen}")
            
            problem = PrinsProblem(instance_data, carbon_price=50.0)
            
            algorithms = [
                EnhancedNSGAII(problem, pop, gen),
                StandardNSGAII(problem, pop, gen),
                SPEA2(problem, pop, gen),
                MOEAD(problem, pop, gen)
            ]
            
            for algo in algorithms:
                start = time.time()
                metrics = algo.run()
                elapsed = time.time() - start
                
                all_results.append({
                    'Instance': sheet_name,
                    'Algorithm': algo.name,
                    'Hypervolume': metrics['hypervolume'],
                    'Best_Cost_USD': metrics['best_cost'],
                    'Best_Emissions_kg': metrics['best_emissions'],
                    'Pareto_Size': metrics['pareto_size'],
                    'Time_Seconds': elapsed
                })
                
                print(f"\n  {algo.name}:")
                print(f"    Cost: ${metrics['best_cost']:.2f}")
                print(f"    CO₂: {metrics['best_emissions']:.1f} kg")
                print(f"    Time: {elapsed:.1f}s")
                
        except Exception as e:
            print(f"  ❌ Error: {e}")
            continue
    
    # Create DataFrame
    results_df = pd.DataFrame(all_results)
    
    # Save results
    results_df.to_csv(OUTPUT_DIR / 'benchmark_results_complete.csv', index=False)
    print(f"\n📊 Results saved to: {OUTPUT_DIR / 'benchmark_results_complete.csv'}")
    
    # Print summary table
    print("\n" + "="*100)
    print(" RESULTS SUMMARY ".center(100, "="))
    print("="*100)
    print(f"\n{'Instance':<20} {'Algorithm':<12} {'HV':<10} {'Best Cost':<14} {'Best CO₂':<12} {'Time':<8}")
    print("-"*100)
    
    for _, row in results_df.iterrows():
        print(f"{row['Instance']:<20} {row['Algorithm']:<12} {row['Hypervolume']:<10.4f} ${row['Best_Cost_USD']:<13.2f} {row['Best_Emissions_kg']:<12.1f} {row['Time_Seconds']:<8.1f}")
    
    # Run statistical tests
    stats_analyzer = StatisticalAnalyzer(results_df)
    stats_analyzer.run_all_tests()
