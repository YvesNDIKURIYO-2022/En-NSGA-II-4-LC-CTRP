class AblationAnalyzer:
    def __init__(self, ablation_results: Dict[str, pd.DataFrame]):
        self.results = ablation_results
        self.variants = ABLATION_VARIANTS
    
    def analyze_component_contributions(self) -> Dict:
        contributions = {}
        
        if 'PA-NSGA-II-Full' in self.results and 'PA-NSGA-II-NoAdapt' in self.results:
            full_hv = self.results['PA-NSGA-II-Full']['Hypervolume'].mean()
            no_adapt_hv = self.results['PA-NSGA-II-NoAdapt']['Hypervolume'].mean()
            contributions['Adaptation'] = (full_hv - no_adapt_hv) / no_adapt_hv * 100 if no_adapt_hv > 0 else 0
        
        if 'PA-NSGA-II-Full' in self.results and 'PA-NSGA-II-NoLS' in self.results:
            full_hv = self.results['PA-NSGA-II-Full']['Hypervolume'].mean()
            no_ls_hv = self.results['PA-NSGA-II-NoLS']['Hypervolume'].mean()
            contributions['Local Search'] = (full_hv - no_ls_hv) / no_ls_hv * 100 if no_ls_hv > 0 else 0
        
        if 'PA-NSGA-II-Full' in self.results and 'PA-NSGA-II-NoInit' in self.results:
            full_hv = self.results['PA-NSGA-II-Full']['Hypervolume'].mean()
            no_init_hv = self.results['PA-NSGA-II-NoInit']['Hypervolume'].mean()
            contributions['Diverse Initialization'] = (full_hv - no_init_hv) / no_init_hv * 100 if no_init_hv > 0 else 0
        
        return contributions
    
