        axes[0].set_xlabel('Variant', fontsize=12)
        axes[0].set_title('Ablation Study: Hypervolume Comparison', fontsize=12)
        axes[0].tick_params(axis='x', rotation=45)
        
        cost_means = [ablation_results[v]['Best_Cost_USD'].mean() for v in variants]
