# STATISTICAL ANALYZER
# ============================================================================

class StatisticalAnalyzer:
    def __init__(self, results_df: pd.DataFrame):
        self.results = results_df
        self.algorithms = ['En-NSGA-II', 'NSGA-II', 'SPEA2', 'MOEA/D']
    
    def run_all_tests(self):
        print("\n" + "="*80)
        print(" STATISTICAL SIGNIFICANCE TESTS ".center(80, "="))
        print("="*80)
        
        hv_data = {algo: [] for algo in self.algorithms}
        emissions_data = {algo: [] for algo in self.algorithms}
        
        for algo in self.algorithms:
            algo_results = self.results[self.results['Algorithm'] == algo]
            hv_data[algo] = [x for x in algo_results['Hypervolume'] if not np.isnan(x)]
            emissions_data[algo] = [x for x in algo_results['Best_Emissions_kg'] if not np.isnan(x)]
        
        # Wilcoxon tests
        print("\n--- Wilcoxon Signed-Rank Tests ---")
        print(f"{'Comparison':<25} {'p-value':<12} {'Significant':<12}")
        print("-"*50)
        
        for i, a1 in enumerate(self.algorithms):
            for j, a2 in enumerate(self.algorithms):
                if i < j:
                    d1, d2 = hv_data[a1], hv_data[a2]
                    if len(d1) == len(d2) and len(d1) >= 2:
                        try:
                            _, p = wilcoxon(d1, d2)
                            sig = "✓" if p < 0.05 else "✗"
                            print(f"{a1} vs {a2:<15} {p:<12.4f} {sig}")
                        except:
                            pass
        
        # Friedman test
        print("\n--- Friedman Test ---")
        algo_lists = [hv_data[a] for a in self.algorithms if len(hv_data[a]) > 0]
        if len(algo_lists) >= 3:
            min_len = min(len(lst) for lst in algo_lists)
            trimmed = [lst[:min_len] for lst in algo_lists]
            stat, p = friedmanchisquare(*trimmed)
            print(f"Hypervolume: χ²={stat:.4f}, p={p:.4f} {'(significant)' if p<0.05 else '(not significant)'}")
        
        # Kruskal-Wallis
        print("\n--- Kruskal-Wallis Test ---")
        algo_lists = [hv_data[a] for a in self.algorithms if len(hv_data[a]) > 0]
        if len(algo_lists) >= 2:
            stat, p = kruskal(*algo_lists)
            print(f"Hypervolume: H={stat:.4f}, p={p:.4f} {'(significant)' if p<0.05 else '(not significant)'}")
        
        return hv_data, emissions_data
    
    def generate_report(self, output_path: Path):
        print("\n" + "="*80)
        print(" DESCRIPTIVE STATISTICS ".center(80, "="))
        print("="*80)
        
        print(f"\n{'Algorithm':<15} {'Mean HV':<12} {'Std HV':<12} {'Mean CO₂':<12} {'Std CO₂':<12}")
        print("-"*65)
        
        for algo in self.algorithms:
            algo_results = self.results[self.results['Algorithm'] == algo]
            if len(algo_results) > 0:
                mean_hv = algo_results['Hypervolume'].mean()
                std_hv = algo_results['Hypervolume'].std()
                mean_co2 = algo_results['Best_Emissions_kg'].mean()
                std_co2 = algo_results['Best_Emissions_kg'].std()
                print(f"{algo:<15} {mean_hv:<12.4f} {std_hv:<12.4f} {mean_co2:<12.2f} {std_co2:<12.2f}")
        
        self.results.to_csv(output_path / 'statistics_summary.csv', index=False)
        print(f"\n✓ Saved to: {output_path / 'statistics_summary.csv'}")


