class EnhancedVisualizer:
    def __init__(self, output_dir: Path):
        self.output_dir = output_dir
        self.plots_dir = output_dir / "plots"
        self.plots_dir.mkdir(exist_ok=True)
        self.algorithms = ALGORITHMS
    
    def create_variance_analysis_plot(self, results_df: pd.DataFrame):
        fig, ax = plt.subplots(figsize=(10, 6))
        
        cv_data = []
        for algo in self.algorithms:
            algo_data = results_df[results_df['Algorithm'] == algo]['Hypervolume'].dropna()
            if len(algo_data) > 0:
                cv = np.std(algo_data, ddof=1) / np.mean(algo_data) if np.mean(algo_data) > 0 else float('inf')
                cv_data.append((algo, cv))
        
        cv_data.sort(key=lambda x: x[1])
        algorithms = [d[0] for d in cv_data]
        cv_values = [d[1] for d in cv_data]
        colors = [COLORS.get(a, '#333333') for a in algorithms]
        
        bars = ax.bar(algorithms, cv_values, color=colors, alpha=0.7, edgecolor='black')
        ax.axhline(y=1.0, color='red', linestyle='--', label='CV=1.0 (High Variance Threshold)')
        ax.set_ylabel('Coefficient of Variation (CV)', fontsize=12)
        ax.set_xlabel('Algorithm', fontsize=12)
        ax.set_title('Algorithm Consistency: Lower CV = More Reliable', fontsize=14)
        ax.legend()
        ax.tick_params(axis='x', rotation=45)
        
        for bar, cv in zip(bars, cv_values):
            ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.05, 
                   f'{cv:.2f}', ha='center', va='bottom', fontsize=10)
        
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'variance_analysis.pdf', dpi=300, bbox_inches='tight')
        plt.close()
        print("  Saved: variance_analysis.pdf")
    
    def create_success_rate_plot(self, results_df: pd.DataFrame):
        fig, ax = plt.subplots(figsize=(8, 6))
        
        pa_data = results_df[results_df['Algorithm'] == 'PA-NSGA-II']['Hypervolume'].dropna().tolist()
        
        success_rates = []
        competitors = []
        
        for algo in self.algorithms[1:]:
            other_data = results_df[results_df['Algorithm'] == algo]['Hypervolume'].dropna().tolist()
            if pa_data and other_data:
                min_len = min(len(pa_data), len(other_data))
                better = sum(1 for i in range(min_len) if pa_data[i] > other_data[i])
                success_rate = better / min_len * 100
                success_rates.append(success_rate)
                competitors.append(algo)
        
        bars = ax.bar(competitors, success_rates, color=[COLORS.get(c, '#333333') for c in competitors], alpha=0.7)
        ax.axhline(y=50, color='red', linestyle='--', label='Random Baseline (50%)')
        ax.axhline(y=70, color='green', linestyle='--', label='Strong Performance (70%)')
        ax.set_ylabel('PA-NSGA-II Success Rate (%)', fontsize=12)
        ax.set_xlabel('Competitor Algorithm', fontsize=12)
        ax.set_title('PA-NSGA-II vs Competitors: % of Runs Where It Wins', fontsize=14)
        ax.set_ylim(0, 100)
        ax.legend()
        
        for bar, rate in zip(bars, success_rates):
            ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 2, 
                   f'{rate:.1f}%', ha='center', va='bottom', fontsize=11, fontweight='bold')
        
        plt.tight_layout()
        plt.savefig(self.plots_dir / 'success_rate.pdf', dpi=300, bbox_inches='tight')
        plt.close()
        print("  Saved: success_rate.pdf")
    
    def create_ablation_plot(self, ablation_results: Dict[str, pd.DataFrame]):
        if not ablation_results:
            return
        
        fig, axes = plt.subplots(1, 2, figsize=(14, 6))
        
        variants = [v for v in ABLATION_VARIANTS if v in ablation_results and len(ablation_results[v]) > 0]
