                        'y': float(row.iloc[2]) if pd.notna(row.iloc[2]) else 0,
                        'capacity': float(row.iloc[3]) if pd.notna(row.iloc[3]) else 140,
                        'fixed_cost': float(row.iloc[4]) if pd.notna(row.iloc[4]) else 10000,
                    }
                    instance_data['depots'].append(depot)
                except:
                    pass
            
            elif 'vehicle capacity' in str(row.iloc[5]) if len(row) > 5 and pd.notna(row.iloc[5]) else False:
                try:
                    instance_data['vehicle_capacity'] = float(row.iloc[6]) if len(row) > 6 and pd.notna(row.iloc[6]) else 150
