class PPOAdaptiveInit:
    """PPO-Adaptive: size-adaptive, ensemble, 4 strategies (PPO, Heuristic, Random, Opposite)"""
    
    def __init__(self, problem: FreightRoutingProblem):
        self.problem = problem
        self.name = "PPO-Adaptive"
        self.pop_size = 100
        self._configure_for_size()
    
    def _configure_for_size(self):
        n = self.problem.n_customers
        if n < 50:
            self.biased_ratio = 0.1
            self.bias_factor = 0.3
        elif n < 100:
            self.biased_ratio = 0.2
            self.bias_factor = 0.2
        else:
            self.biased_ratio = 0.3
            self.bias_factor = 0.1
        
        if self.problem.is_green:
            self.biased_ratio = min(0.4, self.biased_ratio + 0.05)
    
    def _ppo_biased_init(self) -> np.ndarray:
        depot_costs = self.problem.depot_fixed_costs
        best_depots = np.argsort(depot_costs)[:max(1, self.problem.n_depots // 2)]
        ind = np.random.rand(self.problem.n_vars)
        for bd in best_depots:
            mask = np.random.rand(self.problem.n_vars) < 0.2
            ind[mask] = (bd / self.problem.n_depots) + np.random.normal(0, self.bias_factor, np.sum(mask))
        return np.clip(ind, 0, 0.99)
    
    def _nearest_neighbor_init(self) -> np.ndarray:
        ind = np.zeros(self.problem.n_vars)
        for i, cust_coord in enumerate(self.problem.customer_coords):
            distances = [np.linalg.norm(np.array(cust_coord) - np.array(depot_coord)) 
                        for depot_coord in self.problem.depot_coords]
            ind[i] = np.argmin(distances) / self.problem.n_depots
        return ind
    
    def _random_init(self) -> np.ndarray:
        return np.random.rand(self.problem.n_vars)
    
    def _opposite_bias_init(self) -> np.ndarray:
        depot_costs = self.problem.depot_fixed_costs
        worst_depots = np.argsort(depot_costs)[-self.problem.n_depots // 2:]
        ind = np.random.rand(self.problem.n_vars)
        for wd in worst_depots:
            mask = np.random.rand(self.problem.n_vars) < 0.15
            ind[mask] = wd / self.problem.n_depots
        return np.clip(ind, 0, 0.99)
    
    def initialize_population(self) -> List[np.ndarray]:
        population = []
        n_ppo = max(1, int(self.pop_size * self.biased_ratio))
        n_heuristic = max(1, int(self.pop_size * 0.3))
        n_random = max(1, int(self.pop_size * 0.3))
        n_opposite = self.pop_size - n_ppo - n_heuristic - n_random
        
        for _ in range(n_ppo): population.append(self._ppo_biased_init())
        for _ in range(n_heuristic): population.append(self._nearest_neighbor_init())
        for _ in range(n_random): population.append(self._random_init())
        for _ in range(n_opposite): population.append(self._opposite_bias_init())
        
        random.shuffle(population)
        while len(population) < self.pop_size: population.append(self._random_init())
        return population[:self.pop_size]
    
    def evaluate(self):
        pop = self.initialize_population()
        total_cost = 0
        total_emissions = 0
        best_cost = float('inf')
        best_emissions = float('inf')
        
        for ind in pop:
            cost, emissions = self.problem.evaluate(ind)
            total_cost += cost
            total_emissions += emissions
            if cost < best_cost:
                best_cost = cost
            if emissions < best_emissions:
                best_emissions = emissions
        
        return {
            'avg_cost': total_cost / self.pop_size,
            'avg_emissions': total_emissions / self.pop_size,
            'best_cost': best_cost,
            'best_emissions': best_emissions
        }


class ClassicPPOInit:
    """Classic PPO: fixed parameters, single strategy (PPO-biased only)"""
    
    def __init__(self, problem: FreightRoutingProblem):
        self.problem = problem
        self.name = "Classic PPO"
        self.pop_size = 100
        self.biased_ratio = 0.2
        self.bias_factor = 0.2
    
    def _ppo_biased_init(self) -> np.ndarray:
        depot_costs = self.problem.depot_fixed_costs
        best_depots = np.argsort(depot_costs)[:max(1, self.problem.n_depots // 2)]
        ind = np.random.rand(self.problem.n_vars)
        for bd in best_depots:
            mask = np.random.rand(self.problem.n_vars) < 0.2
            ind[mask] = (bd / self.problem.n_depots) + np.random.normal(0, self.bias_factor, np.sum(mask))
        return np.clip(ind, 0, 0.99)
    
    def _random_init(self) -> np.ndarray:
        return np.random.rand(self.problem.n_vars)
    
    def initialize_population(self) -> List[np.ndarray]:
        population = []
        n_biased = int(self.pop_size * self.biased_ratio)
        for i in range(self.pop_size):
            if i < n_biased:
                population.append(self._ppo_biased_init())
            else:
                population.append(self._random_init())
        return population
    
    def evaluate(self):
        pop = self.initialize_population()
        total_cost = 0
        total_emissions = 0
        best_cost = float('inf')
        best_emissions = float('inf')
        
        for ind in pop:
            cost, emissions = self.problem.evaluate(ind)
            total_cost += cost
            total_emissions += emissions
            if cost < best_cost:
                best_cost = cost
            if emissions < best_emissions:
                best_emissions = emissions
        
        return {
            'avg_cost': total_cost / self.pop_size,
            'avg_emissions': total_emissions / self.pop_size,
            'best_cost': best_cost,
            'best_emissions': best_emissions
