                summary_text += f"{method}:\n"
                summary_text += f"  • Avg CO₂: {method_data['Mean_Emissions'].mean():.1f} kg\n"
                summary_text += f"  • Best CO₂: {method_data['Mean_Best_Emissions'].mean():.1f} kg\n"
                summary_text += f"  • Avg Cost: ${method_data['Mean_Cost'].mean():,.0f}\n\n"
        
