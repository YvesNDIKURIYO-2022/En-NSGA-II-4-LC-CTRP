class InitializationComparison:
    def __init__(self, excel_path: str):
        self.excel_path = excel_path
        self.loader = PrinsExcelLoader(excel_path)
        self.results = []
    
    def get_test_instances(self) -> List[str]:
        all_sheets = self.loader.get_all_sheets()
        valid_sheets = []
        for sheet in all_sheets:
            try:
                instance = self.loader.load_instance(sheet)
                if instance['n_depots'] > 0 and instance['n_customers'] >= 10:
                    valid_sheets.append(sheet)
            except:
                pass
        return valid_sheets[:10]  # Test 10 instances
    
    def run_comparison(self, n_runs: int = 3):
        methods = {
            'PPO-Adaptive': PPOAdaptiveInit,
            'Classic PPO': ClassicPPOInit,
            'Random': RandomInit,
            'Cost Greedy': CostGreedyInit,
            'Latin Hypercube': LatinHypercubeInit
        }
        
        instances = self.get_test_instances()
        
        print("\n" + "="*80)
        print(" PPO-ADAPTIVE INITIALIZATION COMPARISON ".center(80, "="))
        print("="*80)
        print(f"\nTesting {len(instances)} instances with {n_runs} runs each")
        print(f"Methods: {list(methods.keys())}")
        print("\nNOTE: Testing ONLY initialization quality (NO evolution)")
        
        for instance_name in instances:
            print("\n" + "-"*60)
            print(f"INSTANCE: {instance_name}")
            print("-"*60)
            
            instance_data = self.loader.load_instance(instance_name)
            print(f"  Depots: {instance_data['n_depots']}, Customers: {instance_data['n_customers']}")
            print(f"  Green: {instance_data['is_green']}, Capacity: {instance_data['vehicle_capacity']}")
            
            for method_name, MethodClass in methods.items():
                print(f"\n  Testing {method_name}...")
                
                costs = []
                emissions = []
                times = []
                best_costs = []
                best_emissions = []
                
                for run in range(n_runs):
                    start = time.time()
                    problem = FreightRoutingProblem(instance_data, carbon_price=50.0)
                    init = MethodClass(problem)
                    result = init.evaluate()
                    elapsed = time.time() - start
                    
                    costs.append(result['avg_cost'])
                    emissions.append(result['avg_emissions'])
                    best_costs.append(result['best_cost'])
                    best_emissions.append(result['best_emissions'])
                    times.append(elapsed)
                
                self.results.append({
                    'Instance': instance_name,
                    'Method': method_name,
                    'Mean_Cost': np.mean(costs),
                    'Std_Cost': np.std(costs),
                    'Mean_Emissions': np.mean(emissions),
                    'Std_Emissions': np.std(emissions),
                    'Mean_Best_Cost': np.mean(best_costs),
                    'Std_Best_Cost': np.std(best_costs),
                    'Mean_Best_Emissions': np.mean(best_emissions),
                    'Std_Best_Emissions': np.std(best_emissions),
                    'Mean_Time': np.mean(times),
                    'Std_Time': np.std(times)
                })
                
                print(f"    Avg Cost: ${np.mean(costs):.2f} ± {np.std(costs):.2f}")
                print(f"    Avg CO₂: {np.mean(emissions):.1f} ± {np.std(emissions):.1f} kg")
                print(f"    Best CO₂: {np.mean(best_emissions):.1f} ± {np.std(best_emissions):.1f} kg")
        
        return pd.DataFrame(self.results)
    
    def print_summary(self, results_df: pd.DataFrame):
        print("\n" + "="*80)
        print(" RESULTS SUMMARY ".center(80, "="))
        print("="*80)
        
        # Overall averages
        print("\nOVERALL AVERAGES (across all instances):")
        print("-"*60)
        print(f"{'Method':<18} {'Avg CO₂ (kg)':<18} {'Best CO₂ (kg)':<18} {'Avg Cost ($)':<18}")
        print("-"*60)
        
        for method in results_df['Method'].unique():
            method_data = results_df[results_df['Method'] == method]
            avg_emissions = method_data['Mean_Emissions'].mean()
            best_emissions = method_data['Mean_Best_Emissions'].mean()
            avg_cost = method_data['Mean_Cost'].mean()
            print(f"{method:<18} {avg_emissions:<18.1f} {best_emissions:<18.1f} ${avg_cost:<17.2f}")
        
        # Improvements over random
        print("\n" + "="*80)
        print(" IMPROVEMENT OVER RANDOM INITIALIZATION ".center(80, "="))
        print("="*80)
        
        random_avg = results_df[results_df['Method'] == 'Random']['Mean_Emissions'].mean()
        random_best = results_df[results_df['Method'] == 'Random']['Mean_Best_Emissions'].mean()
        
        print(f"\n{'Method':<18} {'Avg CO₂ Improvement':<22} {'Best CO₂ Improvement':<22}")
        print("-"*62)
        
        for method in results_df['Method'].unique():
            if method != 'Random':
                method_data = results_df[results_df['Method'] == method]
                avg_emissions = method_data['Mean_Emissions'].mean()
                best_emissions = method_data['Mean_Best_Emissions'].mean()
                avg_imp = (random_avg - avg_emissions) / random_avg * 100
                best_imp = (random_best - best_emissions) / random_best * 100
                print(f"{method:<18} {avg_imp:<22.1f}% {best_imp:<22.1f}%")
        
        # PPO-Adaptive vs Classic PPO comparison
        print("\n" + "="*80)
        print(" PPO-ADAPTIVE vs CLASSIC PPO COMPARISON ".center(80, "="))
        print("="*80)
        
        pa_data = results_df[results_df['Method'] == 'PPO-Adaptive']
        classic_data = results_df[results_df['Method'] == 'Classic PPO']
        
        if len(pa_data) > 0 and len(classic_data) > 0:
            pa_avg = pa_data['Mean_Emissions'].mean()
            classic_avg = classic_data['Mean_Emissions'].mean()
            pa_best = pa_data['Mean_Best_Emissions'].mean()
            classic_best = classic_data['Mean_Best_Emissions'].mean()
            
            print(f"\n  PPO-Adaptive Avg CO₂: {pa_avg:.1f} kg")
            print(f"  Classic PPO Avg CO₂:  {classic_avg:.1f} kg")
            print(f"  → Improvement: {(classic_avg - pa_avg) / classic_avg * 100:.1f}% lower emissions")
            
            print(f"\n  PPO-Adaptive Best CO₂: {pa_best:.1f} kg")
            print(f"  Classic PPO Best CO₂:  {classic_best:.1f} kg")
            print(f"  → Improvement: {(classic_best - pa_best) / classic_best * 100:.1f}% lower emissions")
    
    def save_results(self, results_df: pd.DataFrame):
        results_df.to_csv(OUTPUT_DIR / 'initialization_comparison_results.csv', index=False)
        print(f"\n✓ Results saved to {OUTPUT_DIR / 'initialization_comparison_results.csv'}")


